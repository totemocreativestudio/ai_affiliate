# Marketing Vercel project ONLY. Do not copy dashboard secrets into public variables.
NEXT_PUBLIC_SITE_URL=https://lumaway.online/web
NEXT_PUBLIC_APP_URL=https://app.lumaway.online
# Set true only after production domain, legal review, forms and app auth URLs are verified.
MARKETING_INDEXABLE=false
MARKETING_CONTACT_EMAIL=

# Server-only lead storage. Use a dedicated Supabase secret for this server if possible.
MARKETING_SUPABASE_URL=
MARKETING_SUPABASE_SECRET_KEY=
# Random value of at least 32 bytes; never use NEXT_PUBLIC_ for this.
LEAD_RATE_LIMIT_SALT=

# Optional analytics; consent required. GTM takes precedence over direct GA4 to avoid duplication.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=false
