# Lumaway browser-safe environment
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server secret — never use the publishable key here
SUPABASE_SECRET_KEY=

# OpenAI — server only
OPENAI_API_KEY=

# Xendit — server only
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# WhatsApp OTP provider
WHATSAPP_PROVIDER=flowkirim
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BASE_URL=https://scan.flowkirim.com
WHATSAPP_DEVICE_ID=

# Meta WhatsApp fallback / channel configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=luma_otp
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_CHANNEL_URL=

# Google OAuth configuration reference — actual Google provider credentials
# are configured in Supabase Authentication > Providers > Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
