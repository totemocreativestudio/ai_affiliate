{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "ux-pwa-proration-fixes": false,
      "lumaway-user-access-social-fixes": false,
      "fix/lumaway-production-stabilization": false,
      "fix/vercel-monorepo-deployments": false,
      "fix/dashboard-history-otp-admin-pricing": false,
      "feat/lumaway-ops-intelligence-admin-v4": false,
      "fix/lumaway-marketing-public-rewrite": false,
      "fix/lumaway-web-proxy-origin": false,
      "fix/lumaway-public-insights-live": false
